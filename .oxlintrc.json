{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc"],
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "no-unused-vars": "error"
    },
    "env": {
        "builtin": true
    },
    "ignorePatterns": [
        "**/dist/**",
        "**/node_modules/**",
        "**/.output/**",
        "**/.tanstack/**",
        "**/.turbo/**",
        "**/routeTree.gen.ts",
        "**/src/generated/**",
        "**/storybook-static/**",
        ".agents/skills/**",
        ".claude/skills/**",
        "packages/ui/src/components/**",
        "!packages/ui/src/components/*.stories.tsx",
        "packages/ui/src/hooks/**"
    ],
    "jsPlugins": [
        {
            "name": "react-doctor",
            "specifier": "oxlint-plugin-react-doctor"
        }
    ],
    "overrides": [
        {
            "files": [
                "apps/*/src/**/*.{ts,tsx}",
                "apps/*/.storybook/**/*.{ts,tsx}",
                "packages/ui/src/**/*.{ts,tsx}"
            ],
            "plugins": ["react"],
            "rules": {
                "react/rules-of-hooks": "error",
                "react/exhaustive-deps": "error",
                "no-restricted-imports": [
                    "error",
                    {
                        "paths": [
                            {
                                "name": "react",
                                "importNames": ["memo", "useMemo", "useCallback"],
                                "allowTypeImports": true,
                                "message": "React Compiler owns memoization."
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["apps/*/src/**/*.{ts,tsx}"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "paths": [
                            {
                                "name": "react",
                                "importNames": ["memo", "useMemo", "useCallback"],
                                "allowTypeImports": true,
                                "message": "React Compiler owns memoization."
                            }
                        ],
                        "patterns": [
                            {
                                "group": [
                                    "**/*.fixtures",
                                    "**/*.fixtures.*",
                                    "**/*.stories",
                                    "**/*.stories.*",
                                    "**/.storybook/**"
                                ],
                                "message": "Production code cannot import stories, fixtures or Storybook tooling."
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["apps/*/src/**/*.fixtures.{ts,tsx}", "apps/*/src/**/*.stories.{ts,tsx}"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "paths": [
                            {
                                "name": "react",
                                "importNames": ["memo", "useMemo", "useCallback"],
                                "allowTypeImports": true,
                                "message": "React Compiler owns memoization."
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["packages/ui/src/components/**/*.tsx", "packages/ui/src/hooks/*.ts"],
            "rules": {
                "no-restricted-imports": "off"
            }
        },
        {
            "files": ["packages/ui/src/components/code-block/code-block-highlight.tsx"],
            "rules": {
                "no-control-regex": "off"
            }
        },
        {
            "files": ["packages/ui/src/components/data-grid/data-grid-column-header.tsx"],
            "rules": {
                "oxc/const-comparisons": "off"
            }
        },
        {
            "files": ["packages/ui/src/components/code-block/code-block.tsx"],
            "plugins": ["react"],
            "rules": {
                "react/refs": "off"
            }
        },
        {
            "files": [
                "packages/ui/src/components/code-block/code-block.tsx",
                "packages/ui/src/components/data-grid/data-grid-scroll-area.tsx",
                "packages/ui/src/components/data-grid/data-grid-table-dnd-rows.tsx",
                "packages/ui/src/components/date-selector.tsx",
                "packages/ui/src/components/filters/filters-advanced.tsx",
                "packages/ui/src/components/filters/filters-chip.tsx"
            ],
            "plugins": ["react"],
            "rules": {
                "react/set-state-in-effect": "off"
            }
        },
        {
            "files": [
                "packages/ui/src/components/code-block/code-block.tsx",
                "packages/ui/src/components/data-grid/data-grid-column-header.tsx",
                "packages/ui/src/components/data-grid/data-grid-table-virtual.tsx",
                "packages/ui/src/components/data-grid/data-grid.tsx",
                "packages/ui/src/components/filters/filters-advanced.tsx",
                "packages/ui/src/hooks/use-file-upload.ts"
            ],
            "plugins": ["react"],
            "rules": {
                "react/exhaustive-deps": "off"
            }
        },
        {
            "files": ["packages/ui/src/components/data-grid/data-grid.tsx"],
            "rules": {
                "unicorn/no-useless-fallback-in-spread": "off"
            }
        },
        {
            "files": ["packages/ui/src/components/filters/filters-query.tsx"],
            "rules": {
                "unicorn/no-useless-length-check": "off"
            }
        },
        {
            "files": ["packages/ui/src/components/filters/filters-dnd.tsx"],
            "rules": {
                "unicorn/no-useless-spread": "off"
            }
        },
        {
            "files": ["packages/ui/src/**/*.stories.tsx"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "paths": [
                            {
                                "name": "react",
                                "importNames": ["memo", "useMemo", "useCallback"],
                                "allowTypeImports": true,
                                "message": "React Compiler owns memoization."
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["apps/*/src/**/*.{ts,tsx}", "apps/*/.storybook/**/*.{ts,tsx}"],
            "rules": {
                "react-doctor/no-fetch-in-effect": "error",
                "react-doctor/no-derived-state": "error",
                "react-doctor/no-reset-all-state-on-prop-change": "error",
                "react-doctor/no-array-index-as-key": "error",
                "react-doctor/effect-needs-cleanup": "error",
                "react-doctor/no-pass-live-state-to-parent": "error",
                "react-doctor/no-call-component-as-function": "error",
                "react-doctor/js-hoist-intl": "error",
                "react-doctor/no-react19-deprecated-apis": "error",
                "react-doctor/anchor-has-content": "error",
                "react-doctor/button-has-type": "error",
                "react-doctor/checked-requires-onchange-or-readonly": "error",
                "react-doctor/exhaustive-deps": "error",
                "react-doctor/hooks-no-nan-in-deps": "error",
                "react-doctor/js-combine-iterations": "error",
                "react-doctor/js-flatmap-filter": "error",
                "react-doctor/js-set-map-lookups": "error",
                "react-doctor/jsx-no-constructed-context-values": "error",
                "react-doctor/no-barrel-import": "error",
                "react-doctor/no-derived-useState": "error",
                "react-doctor/no-effect-with-fresh-deps": "error",
                "react-doctor/no-event-handler": "error",
                "react-doctor/no-giant-component": "error",
                "react-doctor/no-many-boolean-props": "error",
                "react-doctor/no-redundant-roles": "error",
                "react-doctor/no-scale-from-zero": "error",
                "react-doctor/only-export-components": "error",
                "react-doctor/prefer-module-scope-pure-function": "error",
                "react-doctor/prefer-module-scope-static-value": "error",
                "react-doctor/prefer-tag-over-role": "error",
                "react-doctor/rerender-lazy-state-init": "error",
                "react-doctor/rerender-memo-with-default-value": "error",
                "react-doctor/use-lazy-motion": "error"
            }
        },
        {
            "files": ["**/*.stories.tsx", "apps/*/src/routes/**/*.tsx"],
            "rules": {
                "react-doctor/only-export-components": "off"
            }
        }
    ]
}
