{
    "name": "@acme/web",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev --port 3000 --strictPort",
        "build": "vite build && bun run build:storybook",
        "build:storybook": "storybook build --quiet",
        "start": "node .output/server/index.mjs",
        "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open",
        "typecheck": "tsr generate && tsc --noEmit",
        "test": "vitest run",
        "test:stories": "vitest run --project=storybook-*"
    },
    "dependencies": {
        "@acme/db": "workspace:*",
        "@acme/ui": "workspace:*",
        "@tailwindcss/vite": "4.3.3",
        "@tanstack/react-query": "5.104.3",
        "@tanstack/react-router": "1.170.45",
        "@tanstack/react-router-ssr-query": "1.167.3",
        "@tanstack/react-start": "1.169.3",
        "better-auth": "1.7.10",
        "nitro": "3.0.260610-beta",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "tailwindcss": "4.3.3",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@storybook/addon-a11y": "10.6.2",
        "@storybook/addon-docs": "10.6.2",
        "@storybook/addon-themes": "10.6.2",
        "@storybook/addon-vitest": "10.6.2",
        "@storybook/react-vite": "10.6.2",
        "@tanstack/router-cli": "1.167.45",
        "@types/node": "24.19.2",
        "@types/react": "19.2.0",
        "@types/react-dom": "19.2.0",
        "@vitejs/plugin-react": "6.1.2",
        "@vitest/browser-playwright": "5.0.5",
        "oxc-transform-react": "0.154.0",
        "playwright": "1.64.1",
        "storybook": "10.6.2",
        "typescript": "6.0.3",
        "vite": "8.3.4",
        "vitest": "5.0.5"
    }
}
