{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write|apply_patch",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$(git rev-parse --show-toplevel)/scripts/hooks/edit-lint.sh\"",
                        "timeout": 45,
                        "statusMessage": "edit-time fmt + fast lint"
                    }
                ]
            }
        ]
    }
}
